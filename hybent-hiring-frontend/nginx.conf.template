# Rendered at container start by the nginx image's envsubst step, which only
# replaces the two variables named in NGINX_ENVSUBST_FILTER. Every other $var
# below is nginx's own and passes through untouched.
#
#   BACKEND_ORIGIN  scheme + host + port, e.g. http://backend:8000
#   BACKEND_HOST    host + port for the Host header, e.g. backend:8000
#
# Defaults in the Dockerfile keep docker-compose working unchanged. A split
# deployment (separate frontend and backend services, as on Render) overrides
# both to the backend's own URL — a compose service name will not resolve
# there, and nginx refuses to start on an unresolvable upstream.
server {
    listen 80;
    server_name _;
    client_max_body_size 60m;

    root /usr/share/nginx/html;
    index index.html;

    # ── Gzip compression ──────────────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Proxy: API calls to FastAPI backend ───────────────────────────────────
    # Mirrors the /v1 proxy in vite.config.ts (used in dev)
    # Timeout is generous (120s) to handle slow Groq/Gemini AI calls
    location /v1/ {
        proxy_pass         ${BACKEND_ORIGIN}/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host              ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Cookie            $http_cookie;
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
        proxy_connect_timeout 30s;
    }

    # ── Proxy: Public API calls (landing page demo requests, etc.) ────────────
    location /api/ {
        proxy_pass         ${BACKEND_ORIGIN}/api/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host              ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Cookie            $http_cookie;
        proxy_read_timeout  120s;
        proxy_send_timeout  120s;
        proxy_connect_timeout 30s;
    }

    # ── Proxy: Uploaded static files (resumes, avatars, etc.) ─────────────────
    location /static/ {
        proxy_pass        ${BACKEND_ORIGIN}/static/;
        proxy_http_version 1.1;
        proxy_set_header  Host       ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header  X-Real-IP  $remote_addr;
        add_header        Cache-Control "public, max-age=86400";
    }

    # ── WebSocket proxy (real-time notifications) ──────────────────────────────
    # Upgrade and Connection headers are REQUIRED for WebSocket handshake
    location /ws/ {
        proxy_pass         ${BACKEND_ORIGIN}/v1/notifications/ws;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }

    # ── nginx health check (for monitoring / load balancers) ──────────────────
    location /nginx-health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # ── Cache: Vite-hashed JS/CSS bundles (filenames include content hash) ─────
    location ~* \.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Cache: images and fonts ────────────────────────────────────────────────
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # ── React SPA fallback ─────────────────────────────────────────────────────
    # Any path not matched above falls through to index.html.
    # We explicitly disable caching for index.html so that the browser always 
    # checks for the latest hashed JS/CSS filenames.
    # Public pages have a prerendered copy in /_seo/ with their own title,
    # description and canonical (vite-plugins/seoPages.ts); serve it first.
    location = / {
        try_files /_seo/index.html /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location / {
        try_files $uri /_seo$uri.html $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
