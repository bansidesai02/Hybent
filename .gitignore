.env
.env.docker
.env.prod

# Dependencies and build output
node_modules/
dist/

# Vite writes these while resolving a TS config
vite.config.ts.timestamp-*.mjs

# Tools
.tools/


# Marketing assets parked out of the way (images, video, generated slides) —
# too large for git, and portfolio-clips holds an auth.json.
archive/marketing/

# TypeScript incremental build cache — regenerated on every build.
*.tsbuildinfo

# Local env backups — may hold secrets.
.env*.bak*

# Demo video work: large media (frames, renders, voice recordings), kept out of git
video/hybent-demo/
video/founder audio files/

# Local workspaces, not part of the app: growth/marketing docs and Claude skills
growth/
.claude/skills/
