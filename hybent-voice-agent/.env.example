# ── Core ───────────────────────────────────────────────────────────────────
APP_ENV=development
# Same Postgres as the Hiring backend; the engine only uses schema "voice".
DATABASE_URL=postgresql+asyncpg://hybent_hiring:CHANGE_ME@localhost:5433/hybent_hiring_db

# Keep exactly one API replica with the scheduler on.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SEC=15

# "fake" ends every call instantly (scripted via task.context._fake) — local dev.
# "livekit" places real calls through the agent worker.
DIALER=fake

# ── LiveKit (real calls) ───────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=hybent-agent
# Outbound trunk created in LiveKit for the Plivo SIP trunk (ST_...).
SIP_OUTBOUND_TRUNK_ID=

# ── Models ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_CALL_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
SARVAM_API_KEY=
# Non-India markets (later)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
