# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Hybent Hiring
APP_ENV=development          # development | production
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Local/Docker dev: the docker-compose Postgres container (below is its default).
# Production: a Supabase Postgres project — use the SESSION POOLER connection
# (aws-<n>-<region>.pooler.supabase.com:5432, username `postgres.<project-ref>`),
# not "Direct connection" (db.<ref>.supabase.co — IPv6-only on many projects;
# breaks on hosts like Render with no IPv6 egress) and not the Transaction
# pooler on 6543 (this app keeps its own long-lived SQLAlchemy pool, which the
# Session pooler matches — see app/core/database.py).
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/hybent_hiring_db

# ── Google Gemini AI (FREE) ───────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Copilot agent v2 (LangGraph) ──────────────────────────────────────────────
# Off by default. Enable for pilot orgs (comma-separated org UUIDs), or for
# everyone with COPILOT_AGENT_V2=true. Approvals are checkpointed in this
# app's Postgres (tables created on startup).
COPILOT_AGENT_V2=false
COPILOT_AGENT_V2_ORGS=
# Optional: pin the agent's Groq model (empty = best available).
COPILOT_AGENT_MODEL=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Leave blank to use console fallback (prints email to terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password     # Google Account → Security → App Passwords
SMTP_FROM_NAME=Hybent Hiring
# Every platform email (invites, password resets, payment links, notifications)
# is sent from this address. SMTP_USER must be this mailbox, or an account
# allowed to send as it (Gmail: Settings → Accounts → "Send mail as").
EMAIL_FROM_ADDRESS=info@hybent.com

# ── Stripe (payments) ─────────────────────────────────────────────────────────
# Leave blank to fall back to emailed requests that the Hybent team invoices.
# Webhook endpoint: <API_URL>/v1/stripe/webhook, events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, invoice.paid, invoice.payment_failed,
# customer.subscription.deleted. Locally: `stripe listen --forward-to localhost:8000/v1/stripe/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Calendar (optional) ────────────────────────────────────────────────
# Leave blank to use fake Meet link fallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/calendar/callback

# ── Email Accounts (per-organization email integrations) ─────────────────────
# Encrypts connected mailbox OAuth tokens / SMTP passwords at rest.
# Set to a strong random value (e.g. `openssl rand -hex 32`) in real deployments.
EMAIL_ACCOUNTS_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above — register this redirect URI
# as an additional one on that same Google OAuth client.
GMAIL_REDIRECT_URI=http://localhost:8000/v1/email-accounts/gmail/callback

# ── Storage (local filesystem) ────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
