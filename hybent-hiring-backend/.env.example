# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Hybent Hiring
APP_ENV=development          # development | production
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Local/Docker dev: the docker-compose Postgres container (below is its default).
# Production: a Supabase Postgres project — use the SESSION POOLER connection
# (aws-<n>-<region>.pooler.supabase.com:5432, username `postgres.<project-ref>`),
# not "Direct connection" (db.<ref>.supabase.co — IPv6-only on many projects;
# breaks on hosts like Render with no IPv6 egress) and not the Transaction
# pooler on 6543 (this app keeps its own long-lived SQLAlchemy pool, which the
# Session pooler matches — see app/core/database.py).
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/hybent_hiring_db

# ── Google Gemini AI (FREE) ───────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Leave blank to use console fallback (prints email to terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password     # Google Account → Security → App Passwords
SMTP_FROM_NAME=Hybent Hiring

# ── Google Calendar (optional) ────────────────────────────────────────────────
# Leave blank to use fake Meet link fallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/calendar/callback

# ── Email Accounts (per-organization email integrations) ─────────────────────
# Encrypts connected mailbox OAuth tokens / SMTP passwords at rest.
# Set to a strong random value (e.g. `openssl rand -hex 32`) in real deployments.
EMAIL_ACCOUNTS_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above — register this redirect URI
# as an additional one on that same Google OAuth client.
GMAIL_REDIRECT_URI=http://localhost:8000/v1/email-accounts/gmail/callback

# ── Storage (local filesystem) ────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
